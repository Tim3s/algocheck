{
  // TypeScript가 프로젝트 코드를 어떤 규칙으로 읽고 검사할지 정합니다.
  "compilerOptions": {
    // 파일 배치 설정
    // "rootDir": "./src",
    // "outDir": "./dist",

    // 실행 환경 설정
    // 자세한 설명은 https://aka.ms/tsconfig/module 에서 볼 수 있습니다.
    "module": "nodenext", // Node.js의 ES module import 규칙을 사용합니다.
    "target": "esnext", // 현재 Node.js가 지원하는 최신 JavaScript 문법을 허용합니다.
    "types": [],
    // Node.js 타입을 사용할 때 필요한 설정입니다.
    // "lib": ["esnext"],
    // "types": ["node"],
    // 위 설정을 사용하려면 npm install -D @types/node 명령으로 타입 정의도 설치합니다.

    // 추가 출력 파일 설정
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // 더 엄격한 타입 검사 설정
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // 코드 작성 방식 검사 설정
    // "noImplicitReturns": true,
    // "noImplicitOverride": true,
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    // "noFallthroughCasesInSwitch": true,
    // "noPropertyAccessFromIndexSignature": true,

    // 권장 설정
    "strict": true, // 타입을 빠뜨리거나 잘못 쓰는 실수를 더 많이 찾아냅니다.
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
  }
}
